# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/catalog_ai

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# S3-compatible storage (MinIO locally, Cloudflare R2 in prod)
S3_ENDPOINT_URL=http://localhost:9000
# Public URL used in presigned URLs (set to http://localhost:9000 locally; differs in Docker where internal is minio:9000)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=catalog-ai
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# fal.ai (AI inference — FLUX.2 images, Kling/Veo video)
FAL_KEY=

# Anthropic (Claude vision — garment auto-fill on upload)
ANTHROPIC_API_KEY=


# Observability
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# App
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/catalog-ai
