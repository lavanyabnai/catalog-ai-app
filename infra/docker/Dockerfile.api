FROM python:3.12-slim AS base
RUN pip install uv

WORKDIR /app

FROM base AS deps
COPY apps/api/pyproject.toml apps/api/uv.lock* ./
RUN uv pip install --system -r pyproject.toml || uv sync --frozen 2>/dev/null || uv pip install --system fastapi uvicorn[standard] pydantic pydantic-settings sqlalchemy alembic asyncpg psycopg2-binary celery redis httpx boto3 python-multipart sentry-sdk langfuse python-jose email-validator

FROM deps AS runner
COPY apps/api/ ./
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
